---
import {
  ArrowRight,
  Bot,
  BookOpen,
  Braces,
  Clock3,
  Files,
  Globe,
  Network,
  Package,
  Palette,
  RotateCcw,
  ShieldCheck,
  Terminal,
} from "@lucide/astro";
import ProductMock from "../components/ProductMock.astro";
import foyaIcon from "../assets/foya-icon.png";
import "../styles/home.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}${path}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Foya 是一个开源、本地优先的个人 Agent。它能读取项目、调用工具和运行自动化，数据与执行权限始终由你控制。"
    />
    <meta name="theme-color" content="#090a0c" />
    <title>Foya · 开源、本地优先的个人 Agent</title>
  </head>
  <body class="m-0 overflow-x-hidden bg-canvas text-foreground">
    <header
      class="sticky top-0 z-20 grid h-16 grid-cols-[1fr_auto_1fr] items-center border-b border-line bg-canvas/90 px-8 backdrop-blur-lg max-[720px]:h-[58px] max-[720px]:grid-cols-[1fr_auto] max-[720px]:px-[18px]"
    >
      <a
        class="inline-flex items-center gap-2.5 text-lg font-bold"
        href={url("/")}
        aria-label="Foya 首页"
      >
        <img
          class="size-[30px] rounded-[7px]"
          src={foyaIcon.src}
          alt=""
          width="30"
          height="30"
        />
        <span>Foya</span>
      </a>
      <nav
        class="flex items-center gap-[30px] text-[13px] font-semibold max-[720px]:hidden"
        aria-label="主导航"
      >
        <a class="text-muted transition-colors hover:text-foreground" href="#workflow"
          >工作方式</a
        >
        <a
          class="text-muted transition-colors hover:text-foreground"
          href="#architecture">架构</a
        >
        <a
          class="text-muted transition-colors hover:text-foreground"
          href={url("/docs/")}>文档</a
        >
      </nav>
      <a
        class="inline-flex items-center justify-self-end gap-[7px] text-[13px] font-semibold text-muted transition-colors hover:text-foreground"
        href="https://github.com/freesoulcode/foya"
        target="_blank"
        rel="noreferrer"
      >
        <svg
          viewBox="0 0 24 24"
          width="17"
          height="17"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.19-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path>
        </svg>
        <span class="max-[720px]:hidden">GitHub</span>
      </a>
    </header>

    <main>
      <section
        class="relative border-b border-line pt-16 max-[720px]:pt-12"
      >
        <div class="mx-auto w-full max-w-[1320px] px-8 max-[720px]:px-[18px]">
          <div class="text-center">
            <h1
              class="m-0 text-[96px] leading-none font-bold tracking-normal max-[900px]:text-[80px] max-[720px]:text-[60px]"
            >
              Foya
            </h1>
            <p
              class="mx-auto mt-5 text-[32px] leading-tight font-medium text-foreground text-balance max-[900px]:text-[27px] max-[720px]:text-[23px]"
            >
              开源、本地优先的个人 Agent
            </p>
            <p
              class="mx-auto mt-4 max-w-[760px] text-[16px] leading-[1.7] text-muted text-pretty max-[720px]:text-[15px]"
            >
              连接自己的模型，在项目中执行任务，也在节点画布中生成图片与视频。数据与执行权限始终由你控制。
            </p>
            <div
              class="mt-6 flex flex-wrap justify-center gap-3 max-[720px]:flex-col"
            >
              <a
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-foreground bg-foreground px-5 py-3 text-sm font-semibold text-canvas transition hover:-translate-y-0.5 hover:border-accent hover:bg-accent"
                href={url("/docs/quick-start/")}
              >
                开始使用
                <ArrowRight size={17} />
              </a>
              <a
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-line-strong bg-transparent px-5 py-3 text-sm font-semibold text-foreground transition hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/5"
                href={url("/docs/")}
              >
                <BookOpen size={17} />
                阅读文档
              </a>
            </div>
          </div>
        </div>

        <ProductMock />
      </section>

      <section
        class="border-b border-line bg-[#0b0b0d] text-foreground"
      >
        <div
          class="mx-auto w-full max-w-[1244px] px-8 py-20 max-[720px]:px-[18px] max-[720px]:py-16"
        >
          <header class="mx-auto max-w-[900px] text-center" data-reveal>
            <h2
              class="m-0 text-5xl leading-[1.12] font-semibold text-balance max-[720px]:text-[36px]"
            >
              你的模型。你的数据。你的控制权。
            </h2>
            <p class="mx-auto mt-5 max-w-[680px] text-[17px] leading-[1.7] text-[#a1a1a6]">
              Foya 在本机运行，把真实操作留在可审查、可恢复的边界内。
            </p>
          </header>

          <div
            class="mt-12 grid grid-cols-12 gap-4 max-[900px]:grid-cols-1 max-[720px]:mt-9"
            data-reveal
          >
            <article
              class="col-span-7 row-span-2 flex min-h-[436px] flex-col overflow-hidden rounded-lg border border-white/10 bg-[#141416] p-8 text-white max-[900px]:col-span-1 max-[900px]:row-span-1 max-[900px]:min-h-[360px] max-[720px]:p-6"
            >
              <div class="flex items-center gap-2 text-[#2997ff]">
                <Terminal size={18} />
                <span class="text-sm font-semibold">本机内核</span>
              </div>
              <h3 class="mt-5 max-w-[520px] text-[34px] leading-tight font-semibold max-[720px]:text-[28px]">
                任务在你的机器上真正发生。
              </h3>
              <p class="mt-4 max-w-[500px] text-sm leading-[1.7] text-[#a1a1a6]">
                Go 内核持有会话、工具与状态；项目文件不需要交给另一套云端工作区。
              </p>
              <div
                class="mt-auto overflow-hidden rounded-md border border-white/10 bg-[#090a0c] font-mono"
              >
                <div class="flex h-10 items-center gap-1.5 border-b border-white/10 px-4">
                  <span class="size-1.5 rounded-full bg-red-400"></span>
                  <span class="size-1.5 rounded-full bg-amber-400"></span>
                  <span class="size-1.5 rounded-full bg-emerald-400"></span>
                  <span class="ml-2 text-[9px] text-[#6e6e73]">LOCAL RUNTIME</span>
                </div>
                <div class="space-y-1 px-5 py-5 text-[11px] leading-6">
                  <p class="m-0 text-[#86868b]">$ make desktop-dev</p>
                  <p class="m-0 text-[#f5f5f7]">foya kernel listening on kernel.sock</p>
                  <p class="m-0 text-emerald-400">ready · workspace mounted</p>
                </div>
              </div>
            </article>

            <article
              class="col-span-5 flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-6 max-[900px]:col-span-1 max-[720px]:p-6"
            >
              <div class="flex items-center gap-2 text-[#0071e3]">
                <Network size={18} />
                <span class="text-sm font-semibold">自带模型</span>
              </div>
              <h3 class="mt-4 text-[26px] leading-tight font-semibold text-white">
                每个会话，自由选择模型。
              </h3>
              <div class="mt-auto divide-y divide-white/10 border-y border-white/10 text-xs text-[#f5f5f7]">
                <div class="flex items-center gap-3 py-3">
                  <span class="font-mono text-[9px] text-[#86868b]">LANGUAGE</span>
                  <span class="flex-1">OpenAI compatible</span>
                  <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </div>
                <div class="flex items-center gap-3 py-3">
                  <span class="font-mono text-[9px] text-[#86868b]">IMAGE</span>
                  <span class="flex-1">Canvas generation</span>
                  <span class="size-1.5 rounded-full bg-[#2997ff]"></span>
                </div>
              </div>
            </article>

            <article
              class="col-span-5 flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-6 max-[900px]:col-span-1 max-[720px]:p-6"
            >
              <div class="flex items-center gap-2 text-[#0071e3]">
                <RotateCcw size={18} />
                <span class="text-sm font-semibold">变更可回退</span>
              </div>
              <h3 class="mt-4 text-[26px] leading-tight font-semibold text-white">
                每次修改，都有返回的路。
              </h3>
              <div class="mt-auto rounded-md border border-white/10 bg-[#101012] px-4 py-3 text-white">
                <div class="flex items-center gap-3">
                  <span class="min-w-0 flex-1">
                    <strong class="block truncate text-xs font-semibold">3 个文件已更改</strong>
                    <small class="mt-1 block font-mono text-[9px] text-[#86868b]">+312&nbsp;&nbsp;-18</small>
                  </span>
                  <span class="rounded border border-white/10 px-2 py-1 text-[10px] text-[#a1a1a6]">撤销全部</span>
                  <span class="rounded bg-[#f5f5f7] px-2 py-1 text-[10px] font-semibold text-[#1d1d1f]">保留全部</span>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="workflow" class="border-b border-line bg-black">
        <div
          class="mx-auto w-full max-w-[1244px] px-8 py-20 max-[720px]:px-[18px] max-[720px]:py-16"
        >
          <header class="mx-auto max-w-[900px] text-center" data-reveal>
            <h2
              class="m-0 text-5xl leading-[1.12] font-semibold text-balance max-[720px]:text-[36px]"
            >
              从一句需求，到可以验证的结果。
            </h2>
            <p class="mx-auto mt-5 max-w-[700px] text-[17px] leading-[1.7] text-[#a1a1a6]">
              会话、工具和验证沿同一条任务链推进，过程持续记录。
            </p>
          </header>

          <ol class="mt-12 border-t border-white/12" data-reveal>
            <li
              class="grid grid-cols-[48px_220px_minmax(0,1fr)_auto] items-center gap-6 border-b border-white/12 py-6 max-[900px]:grid-cols-[40px_minmax(0,1fr)] max-[900px]:gap-4"
            >
              <span class="font-mono text-[10px] text-[#6e6e73]">01</span>
              <span class="flex items-center gap-3">
                <Terminal class="text-[#2997ff]" size={22} />
                <strong class="text-xl font-semibold">进入项目</strong>
              </span>
              <p class="m-0 text-sm leading-[1.7] text-[#a1a1a6] max-[900px]:col-start-2">
                读取代码、搜索上下文、执行命令，理解真实工作区。
              </p>
              <small class="font-mono text-[9px] text-[#6e6e73] max-[900px]:col-start-2">
                FILES · TERMINAL · DIFF
              </small>
            </li>
            <li
              class="grid grid-cols-[48px_220px_minmax(0,1fr)_auto] items-center gap-6 border-b border-white/12 py-6 max-[900px]:grid-cols-[40px_minmax(0,1fr)] max-[900px]:gap-4"
            >
              <span class="font-mono text-[10px] text-[#6e6e73]">02</span>
              <span class="flex items-center gap-3">
                <Braces class="text-[#2997ff]" size={22} />
                <strong class="text-xl font-semibold">持续推进</strong>
              </span>
              <p class="m-0 text-sm leading-[1.7] text-[#a1a1a6] max-[900px]:col-start-2">
                工具结果进入下一轮上下文，任务在 Session 中持续推进。
              </p>
              <small class="font-mono text-[9px] text-[#6e6e73] max-[900px]:col-start-2">
                SESSION · CONTEXT · MEMORY
              </small>
            </li>
            <li
              class="grid grid-cols-[48px_220px_minmax(0,1fr)_auto] items-center gap-6 border-b border-white/12 py-6 max-[900px]:grid-cols-[40px_minmax(0,1fr)] max-[900px]:gap-4"
            >
              <span class="font-mono text-[10px] text-[#6e6e73]">03</span>
              <span class="flex items-center gap-3">
                <ShieldCheck class="text-[#2997ff]" size={22} />
                <strong class="text-xl font-semibold">控制副作用</strong>
              </span>
              <p class="m-0 text-sm leading-[1.7] text-[#a1a1a6] max-[900px]:col-start-2">
                审批、模型守卫和沙箱共同约束每一次真实操作。
              </p>
              <small class="font-mono text-[9px] text-[#6e6e73] max-[900px]:col-start-2">
                APPROVAL · GUARD · SANDBOX
              </small>
            </li>
            <li
              class="grid grid-cols-[48px_220px_minmax(0,1fr)_auto] items-center gap-6 border-b border-white/12 py-6 max-[900px]:grid-cols-[40px_minmax(0,1fr)] max-[900px]:gap-4"
            >
              <span class="font-mono text-[10px] text-[#6e6e73]">04</span>
              <span class="flex items-center gap-3">
                <Network class="text-[#2997ff]" size={22} />
                <strong class="text-xl font-semibold">Skills + MCP</strong>
              </span>
              <p class="m-0 text-sm leading-[1.7] text-[#a1a1a6] max-[900px]:col-start-2">
                接入专业流程、外部工具和并发子 Agent。
              </p>
              <small class="font-mono text-[9px] text-[#6e6e73] max-[900px]:col-start-2">
                SKILLS · MCP · SUBAGENTS
              </small>
            </li>
          </ol>
        </div>
      </section>

      <section class="border-b border-line bg-[#0b0b0d]">
        <div
          class="mx-auto w-full max-w-[1244px] px-8 py-16 max-[720px]:px-[18px] max-[720px]:py-14"
        >
          <header class="mx-auto max-w-[900px] text-center" data-reveal>
            <h2
              class="m-0 text-5xl leading-[1.12] font-semibold text-balance max-[720px]:text-[36px]"
            >
              Agent 的能力，不止对话。
            </h2>
            <p class="mx-auto mt-5 max-w-[680px] text-[17px] leading-[1.7] text-[#a1a1a6]">
              代码、自动化、浏览器和视觉生成，共用同一个本地运行时。
            </p>
          </header>

          <div
            class="mt-12 grid grid-cols-3 gap-3 max-[980px]:grid-cols-2 max-[680px]:grid-cols-1"
            data-reveal
          >
            <article class="flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-5">
              <span class="grid size-9 place-items-center rounded-md bg-[#2997ff]/10 text-[#2997ff]">
                <Files size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">文件审查</h3>
              <p class="mt-2 mb-0 text-sm leading-[1.6] text-[#a1a1a6]">
                逐项查看 Diff，按文件保留或撤销修改。
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px]">
                <span class="text-[#86868b]">4 FILES CHANGED</span>
                <span class="text-emerald-400">+312&nbsp;&nbsp;-18</span>
              </div>
            </article>
            <article class="flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-5">
              <span class="grid size-9 place-items-center rounded-md bg-[#2997ff]/10 text-[#2997ff]">
                <Bot size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">并行子 Agent</h3>
              <p class="mt-2 mb-0 text-sm leading-[1.6] text-[#a1a1a6]">
                搜索、实现和验证由不同角色同时推进。
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px]">
                <span class="text-[#86868b]">3 AGENTS ACTIVE</span>
                <span class="flex gap-1">
                  <i class="size-1.5 rounded-full bg-emerald-400"></i>
                  <i class="size-1.5 rounded-full bg-emerald-400"></i>
                  <i class="size-1.5 rounded-full bg-[#2997ff]"></i>
                </span>
              </div>
            </article>
            <article class="flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-5">
              <span class="grid size-9 place-items-center rounded-md bg-[#2997ff]/10 text-[#2997ff]">
                <Clock3 size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">自动化任务</h3>
              <p class="mt-2 mb-0 text-sm leading-[1.6] text-[#a1a1a6]">
                按计划重复运行任务，保留每次执行结果。
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px]">
                <span class="text-[#86868b]">NEXT RUN</span>
                <span class="text-[#f5f5f7]">09:00 · DAILY</span>
              </div>
            </article>
            <article class="flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-5">
              <span class="grid size-9 place-items-center rounded-md bg-[#2997ff]/10 text-[#2997ff]">
                <Package size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">插件与 MCP</h3>
              <p class="mt-2 mb-0 text-sm leading-[1.6] text-[#a1a1a6]">
                连接数据库、文档和已有工具服务。
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px]">
                <span class="text-[#86868b]">12 INSTALLED</span>
                <span class="text-emerald-400">ALL READY</span>
              </div>
            </article>
            <article class="flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-5">
              <span class="grid size-9 place-items-center rounded-md bg-[#2997ff]/10 text-[#2997ff]">
                <Globe size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">浏览器操作</h3>
              <p class="mt-2 mb-0 text-sm leading-[1.6] text-[#a1a1a6]">
                搜索、阅读并完成真实页面交互。
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px]">
                <span class="text-[#86868b]">3 TABS</span>
                <span class="text-emerald-400">CONNECTED</span>
              </div>
            </article>
            <article class="flex min-h-[210px] flex-col rounded-lg border border-white/10 bg-[#171719] p-5">
              <span class="grid size-9 place-items-center rounded-md bg-[#2997ff]/10 text-[#2997ff]">
                <Palette size={20} />
              </span>
              <h3 class="mt-5 text-lg font-semibold">视觉画布</h3>
              <p class="mt-2 mb-0 text-sm leading-[1.6] text-[#a1a1a6]">
                串联提示词、参考图和生成结果。
              </p>
              <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px]">
                <span class="text-[#86868b]">4 NODES</span>
                <span class="text-[#2997ff]">2 OUTPUTS</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section
        id="architecture"
        class="border-b border-line bg-[#101012]"
      >
        <div
          class="mx-auto w-full max-w-[1244px] px-8 py-20 max-[720px]:px-[18px] max-[720px]:py-16"
        >
          <header class="mx-auto max-w-[860px] text-center" data-reveal>
            <h2
              class="m-0 text-5xl leading-[1.12] font-semibold text-balance max-[720px]:text-[36px]"
            >
              一个内核。所有入口。
            </h2>
            <p class="mx-auto mt-5 max-w-[700px] text-[17px] leading-[1.7] text-[#a1a1a6]">
              桌面端、CLI、飞书和自动化，共享同一套会话、调度与工具执行能力。
            </p>
            <a
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#2997ff] hover:text-[#64b5ff]"
              href={url("/docs/technical/architecture/")}
            >
              查看实现架构
              <ArrowRight size={16} />
            </a>
          </header>

        <div
          class="mx-auto mt-12 max-w-[1000px] overflow-hidden rounded-lg border border-line bg-[#0c0d10]"
          data-reveal
        >
          <div
            class="flex h-11 items-center justify-between border-b border-line px-4 font-mono text-[10px]"
          >
            <span class="text-faint">FOYA / LOCAL RUNTIME</span>
            <span class="flex items-center gap-2 text-emerald-400">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              READY
            </span>
          </div>
          <div class="p-6 max-[720px]:p-4">
            <p class="mb-3 font-mono text-[9px] text-faint">CLIENTS</p>
            <div class="grid grid-cols-4 gap-2 text-center text-xs max-[720px]:grid-cols-2">
              <span class="border border-line bg-white/[0.025] px-3 py-2.5">桌面端</span>
